   #!/bin/bash
# =============================================================================
# CIVET Pipeline Configuration
# =============================================================================
# Copy this file to your home directory and fill in all paths:
#   cp pipeline.env.template ~/civet_pipeline.env
#
# Then pass it to any submission script:
#   bash submit_civet.sh ~/civet_pipeline.env
# =============================================================================

# -- HPC environment -----------------------------------------------------------
# Comma-separated list of paths the container needs to access on your cluster.
# Apptainer reads this automatically — no -B flags needed in scripts.
# Example for UNC Longleaf: "/work,/proj,/users,/nas"
export APPTAINER_BIND=""

# -- CIVET container image (Apptainer/Singularity .sif) -----------------------
# Build from: https://github.com/aces/CIVET_Full_Project
# Or pull:    apptainer pull docker://mcin/civet:2.1.1
CIVET_IMG=""

# -- CIVET processing options -------------------------------------------------
# Study prefix — used in CIVET naming convention: <prefix>_<id>_t1.mnc
CIVET_PREFIX="study"

# N3 correction distance: 200 for 1.5T, 50-125 for 3T (75 is a safe default for 3T)
CIVET_N3_DISTANCE="200"

# Additional CIVET flags (appended to every run_civet.sh invocation)
# Recommended defaults:
CIVET_EXTRA_FLAGS="-lsq12 -resample-surfaces -thickness tlaplace:tfs:tlink 30:20 -VBM -combine-surfaces -correct-pve -mask-hippocampus -surface-atlas AAL"

# -- User directories (CHANGE THESE) -----------------------------------------
BIDS_DIR=""          # BIDS-formatted input data (for NIfTI→MINC conversion)
SOURCE_DIR=""        # MINC input directory (after conversion, or if already MINC)
TARGET_DIR=""        # Where CIVET outputs go (one subdir per subject)
WORK_DIR=""          # Temporary processing (can be deleted between batches)
LOG_DIR=""           # SLURM .out/.err log files

# -- Batch processing settings ------------------------------------------------
BATCH_SIZE=100       # Subjects per batch (lower than fMRIPrep due to longer runtime)
SLURM_CPUS=4         # CPUs per job (CIVET is mostly single-threaded)
SLURM_MEM="16g"      # Memory per job (CIVET is light on memory)
SLURM_TIME="0-14:00:00"  # Time limit per job (14 hours for safety)
